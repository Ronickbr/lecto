# =============================================================================
# Lecto — Variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env — ele está no .gitignore.
#
# Prefixo VITE_ = exposto ao cliente (navegador). NÃO coloque segredos aí.
# Sem prefixo = somente servidor (Nitro / Node).
# =============================================================================

# --- Supabase ---------------------------------------------------------------
# URL base do projeto Supabase (https://<ref>.supabase.co ou self-hosted).
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxx"

# As mesmas, prefixadas para o cliente (apenas as chaves públicas).
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"

# --- IA Generativa (Vercel AI SDK) ------------------------------------------
# Provedor compatível com a API OpenAI (ver src/lib/ai-gateway.server.ts).
AI_BASE_URL="https://openrouter.ai/api/v1"
AI_API_KEY="sk-or-v1-xxx"
AI_MODEL="google/gemini-3.6-flash"

# --- Webhooks / Pagamentos --------------------------------------------------
# Segredo usado para assinar (HMAC-SHA256) e validar webhooks de pagamento.
WEBHOOK_SECRET="mude-para-um-segredo-longo-e-aleatorio"

# Mercado Pago — Checkout Pro (preferences) + webhook.
MERCADO_PAGO_ACCESS_TOKEN="APP_USR-xxx"
# Opcional: segredo dedicado do webhook. Se ausente, o access token é usado.
# MERCADO_PAGO_WEBHOOK_SECRET=""

# InfinityPay — Checkout integrado (api.checkout.infinitepay.io). Autenticado
# pela InfiniteTag (handle, sem o símbolo $). Não exige API key.
INFINITYPAY_HANDLE="sua_handle_sem_o_sifrao"

# --- E-mails transacionais (Resend) ------------------------------------------
RESEND_API_KEY="re_xxx"
RESEND_FROM_EMAIL="Lecto <no-reply@lecto.app>"

# URL pública usada para montar links de redirecionamento dos checkouts.
# APP_URL="https://lecto.app"

# --- Servidor / Deploy ------------------------------------------------------
# Porta e host do runtime Node (usado pelo preset node-server / Docker).
PORT="3000"
HOST="0.0.0.0"

# Preset de build do Nitro: node-server (Docker/Vercel) ou cloudflare-module.
# NITRO_PRESET="node-server"

# --- Testes E2E (Playwright) ------------------------------------------------
# URL onde a aplicação está rodando durante os testes.
E2E_BASE_URL="http://localhost:8080"
